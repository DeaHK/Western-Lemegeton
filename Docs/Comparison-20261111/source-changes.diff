@@ -0,0 +1,86 @@
+using UnityEngine;
+
+namespace WesternLemegeton
+{
+    public sealed partial class LoganBossAttack
+    {
+        [Header("Dynamite avoidance")]
+        public bool EnableDynamiteDodge = true;
+        [Min(.1f)] public float DodgeDistance = 4;
+        [Min(.01f)] public float DodgeSeconds = .4f;
+        [Min(0)] public float DodgeHeight = .7f;
+        [Min(0)] public float DodgeSafetyMargin = .2f;
+        bool dodging;
+        float dodgeElapsed, resumeHeight;
+        Vector2 dodgeStart, dodgeTarget;
+        ActionState resumeAction;
+        public bool IsDodgingDynamite => dodging;
+        public Vector2 DodgeTarget => dodgeTarget;
+
+        bool TickDynamiteDodge(Dungeon game, float dt)
+        {
+            if(!dodging)
+            {
+                if(!EnableDynamiteDodge) return false;
+                var volleys=Object.FindObjectsByType<LoganDynamiteVolley>(FindObjectsSortMode.None);
+                float margin=Mathf.Max(0,BodyRadius)+Mathf.Max(0,DodgeSafetyMargin);
+                Vector2 position=transform.position;
+                if(!Dangerous(volleys,position,margin) || !FindDodgeLanding(volleys,game.Pos,margin,out var landing)) return false;
+                dodging=true; dodgeElapsed=0; dodgeStart=position; dodgeTarget=landing;
+                resumeAction=Action; resumeHeight=visualHeight; Action=ActionState.Dodge;
+                // 이미 총 난사 도약 중이었다면 회피 착지를 그 도약의 완료로 취급합니다.
+                // 이전 보간 좌표로 되돌아가는 것을 막고 이후 조준부터 이어갑니다.
+                if(resumeAction==ActionState.Leap) { resumeAction=ActionState.Aim; resumeHeight=0; elapsed=0; }
+                if(owner) owner.SetMeleeWarning(false,0);
+            }
+            // 패턴 타이머와 쿨타임은 회피 중 보존합니다. 회피는 별도 공격 패턴을 시작하지 않습니다.
+            dodgeElapsed+=dt;
+            float t=Mathf.Clamp01(dodgeElapsed/Mathf.Max(.01f,DodgeSeconds));
+            Vector2 from=transform.position, next=Vector2.Lerp(dodgeStart,dodgeTarget,t);
+            int steps=Mathf.Max(1,Mathf.CeilToInt(Vector2.Distance(from,next)/.1f));
+            bool blocked=false;
+            for(int i=1;i<=steps;i++)
+            {
+                Vector2 p=Vector2.Lerp(from,next,i/(float)steps);
+                if(HauntedBullAttack.Blocked(p,BodyRadius)) { blocked=true; break; }
+                transform.position=p;
+            }
+            SetHeight(Mathf.Lerp(resumeHeight,0,t)+4*Mathf.Max(0,DodgeHeight)*t*(1-t));
+            if(t>=1 || blocked)
+            {
+                dodging=false; Action=resumeAction; SetHeight(resumeHeight);
+            }
+            return true;
+        }
+        static bool Dangerous(LoganDynamiteVolley[] volleys,Vector2 p,float margin)
+        {
+            foreach(var volley in volleys) if(volley && volley.Threatens(p,margin)) return true;
+            return false;
+        }
+        bool FindDodgeLanding(LoganDynamiteVolley[] volleys,Vector2 hunter,float margin,out Vector2 target)
+        {
+            Vector2 start=transform.position;
+            target=start; bool found=false; float best=float.NegativeInfinity;
+            int steps=Mathf.Max(1,Mathf.CeilToInt(Mathf.Max(.1f,DodgeDistance)/.1f));
+            for(int a=0;a<72;a++)
+            {
+                float angle=a*Mathf.PI/36;
+                Vector2 direction=new Vector2(Mathf.Cos(angle),Mathf.Sin(angle));
+                for(int i=1;i<=steps;i++)
+                {
+                    Vector2 p=start+direction*(Mathf.Max(.1f,DodgeDistance)*i/steps);
+                    if(HauntedBullAttack.Blocked(p,BodyRadius)) break;
+                    if(Dangerous(volleys,p,margin)) continue;
+                    float score=(p-hunter).sqrMagnitude;
+                    if(!found || score>best) { found=true; best=score; target=p; }
+                }
+            }
+            return found;
+        }
+        void CancelDodge()
+        {
+            if(!dodging) return;
+            dodging=false; Action=resumeAction; SetHeight(resumeHeight);
+        }
+    }
+}
--- main/Assets/Scripts/Enemy/Enemy_Boss_Logan/LoganDynamiteVolley.cs
+++ testWL/Assets/Scripts/Enemy/Enemy_Boss_Logan/LoganDynamiteVolley.cs
@@ -0,0 +1,90 @@
+using System.Collections.Generic;
+using UnityEngine;
+
+namespace WesternLemegeton
+{
+    // 한 번 투척한 묶음 전체가 명중 기록을 공유하므로 착지/폭발 시각이 달라도 중복 피해가 없습니다.
+    public sealed class LoganDynamiteVolley : MonoBehaviour
+    {
+        sealed class Bomb
+        {
+            public Vector2 Target;
+            public float FlightTime;
+            public SpriteRenderer Visual, Warning;
+            public PaperCard Card;
+            public bool Landed, Exploded;
+        }
+        readonly List<Bomb> bombs=new List<Bomb>();
+        readonly HashSet<int> victims=new HashSet<int>();
+        readonly List<Enemy> enemySnapshot=new List<Enemy>();
+        Vector2 start;
+        float age, damage, radius, fuse, height;
+        bool hunterHit;
+        public int BombCount => bombs.Count;
+        // 비행 중인 폭탄도 고정된 착지 예정 범위를 위험 구역으로 제공합니다.
+        public bool Threatens(Vector2 position, float margin)
+        {
+            if(!isActiveAndEnabled) return false;
+            foreach(var bomb in bombs)
+                if(!bomb.Exploded && Vector2.Distance(position,bomb.Target)<=radius+Mathf.Max(0,margin)) return true;
+            return false;
+        }
+        public static LoganDynamiteVolley Spawn(Vector2 origin, Vector2 target, LoganBossAttack.DynamiteSettings settings)
+        {
+            var volley=new GameObject("Logan / Dynamite volley").AddComponent<LoganDynamiteVolley>();
+            volley.start=origin; volley.damage=Mathf.Max(0,settings.Damage);
+            volley.radius=Mathf.Max(.01f,settings.ExplosionRadius); volley.fuse=Mathf.Max(0,settings.FuseSeconds);
+            volley.height=Mathf.Max(0,settings.ArcHeight);
+            int count=1+Mathf.Max(0,settings.AdditionalCount);
+            for(int i=0;i<count;i++)
+            {
+                Vector2 landing=Rules.ClampToRoom(target+Random.insideUnitCircle*Mathf.Max(0,settings.ScatterRadius),.05f);
+                var visual=Ink.Shape("Logan / Dynamite",volley.transform,origin,new Vector2(.25f,.45f),Ink.Red,1000);
+                var bomb=new Bomb { Target=landing, Visual=visual, Card=visual.GetComponent<PaperCard>(),
+                    FlightTime=Mathf.Max(.01f,Vector2.Distance(origin,landing)/Mathf.Max(.01f,settings.FlightSpeed)) };
+                if(bomb.Card) bomb.Card.Flat=false;
+                volley.bombs.Add(bomb);
+            }
+            return volley;
+        }
+        void Update() { if(Dungeon.I && Dungeon.I.Running) Advance(Dungeon.I,Time.deltaTime); }
+        public void Advance(Dungeon game,float dt)
+        {
+            if(!game || !game.Running) return;
+            age+=Mathf.Max(0,dt);
+            bool finished=true;
+            foreach(var bomb in bombs)
+            {
+                if(bomb.Exploded) continue;
+                float t=Mathf.Clamp01(age/bomb.FlightTime);
+                if(bomb.Visual) bomb.Visual.transform.position=Vector2.Lerp(start,bomb.Target,t);
+                if(bomb.Card) bomb.Card.RenderOffset=Vector3.up*(4*height*t*(1-t));
+                if(t>=1 && !bomb.Landed)
+                {
+                    bomb.Landed=true;
+                    bomb.Warning=Ink.Shape("Logan / Explosion warning",transform,bomb.Target,Vector2.one*radius*2,
+                        new Color(1,.25f,.05f,.3f),-590,true);
+                }
+                if(age>=bomb.FlightTime+fuse)
+                {
+                    bomb.Exploded=true;
+                    if(bomb.Visual) bomb.Visual.enabled=false;
+                    if(bomb.Warning) bomb.Warning.enabled=false;
+                    Explode(game,bomb.Target);
+                }
+                else finished=false;
+            }
+            if(finished) RobeManPoisonZone.Remove(gameObject);
+        }
+        void Explode(Dungeon game,Vector2 center)
+        {
+            Ink.Ring(center,radius,Ink.Red,.3f);
+            enemySnapshot.Clear(); enemySnapshot.AddRange(game.Enemies);
+            foreach(var enemy in enemySnapshot)
+                if(enemy && !enemy.Dead && enemy.gameObject.activeInHierarchy && Vector2.Distance(center,enemy.transform.position)<=radius && victims.Add(enemy.GetInstanceID()))
+                    enemy.TakeEnvironmentDamage(damage);
+            if(!hunterHit && game.Hero && game.Hero.Hp>0 && Vector2.Distance(center,game.Pos)<=radius)
+            { hunterHit=true; game.Hero.Hurt(damage); }
+        }
+    }
+}
