+
+        // 실행 중에는 프레임 종료 시, 에디터 검사 중에는 즉시 오브젝트를 제거합니다.
+        public static void Remove(GameObject target)
+        {
+            if (!target) return;
+            if (Application.isPlaying) Destroy(target);
+            else DestroyImmediate(target);
+        }
+    }
